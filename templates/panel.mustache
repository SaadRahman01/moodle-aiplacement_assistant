{{!
    @template aiplacement_assistant/panel

    Floating button and (initially hidden) side panel for the Moodle Assistant.
    The panel contents are filled in by the aiplacement_assistant/chat module.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="aiplacement_assistant-panel" and the data-region/data-action attributes inside it.

    Context variables required for this template:
    * uniqid - Unique id for this template instance (provided automatically).

    Example context (json):
    {
        "uniqid": "abc123"
    }
}}
<div class="aiplacement_assistant" data-region="aiplacement_assistant-panel">
    <button type="button" class="btn btn-primary rounded-pill aiplacement_assistant-button"
            data-action="aiplacement_assistant-open"
            aria-controls="aiplacement_assistant-drawer-{{uniqid}}" aria-expanded="false">
        {{#pix}} t/message, core {{/pix}}
        <span>{{#str}} openassistant, aiplacement_assistant {{/str}}</span>
    </button>
    <section id="aiplacement_assistant-drawer-{{uniqid}}" class="aiplacement_assistant-drawer border shadow"
             data-region="aiplacement_assistant-drawer" role="dialog" aria-modal="true"
             aria-labelledby="aiplacement_assistant-title-{{uniqid}}" hidden>
        <header class="d-flex align-items-center justify-content-between p-2 border-bottom">
            <h2 id="aiplacement_assistant-title-{{uniqid}}" class="h5 m-0">
                {{#str}} pluginname, aiplacement_assistant {{/str}}
            </h2>
            <button type="button" class="btn btn-link btn-icon icon-no-margin" data-action="aiplacement_assistant-close"
                    aria-label="{{#str}} closeassistant, aiplacement_assistant {{/str}}">
                {{#pix}} e/cancel, core {{/pix}}
            </button>
        </header>
        <div class="aiplacement_assistant-body p-2" data-region="aiplacement_assistant-body">
            <div data-region="aiplacement_assistant-policy"></div>
            <div class="aiplacement_assistant-messages" data-region="aiplacement_assistant-messages"
                 role="log" aria-live="polite" aria-relevant="additions"
                 aria-label="{{#str}} messages, aiplacement_assistant {{/str}}"></div>
            <div class="aiplacement_assistant-thinking text-muted small" data-region="aiplacement_assistant-thinking" hidden>
                {{#str}} thinking, aiplacement_assistant {{/str}}
            </div>
        </div>
        <form class="aiplacement_assistant-form p-2 border-top" data-region="aiplacement_assistant-form" hidden>
            <label for="aiplacement_assistant-input-{{uniqid}}" class="sr-only visually-hidden">
                {{#str}} messagelabel, aiplacement_assistant {{/str}}
            </label>
            <textarea id="aiplacement_assistant-input-{{uniqid}}" class="form-control me-2 mr-2" rows="2" maxlength="2000"
                      data-region="aiplacement_assistant-input"
                      placeholder="{{#str}} messageplaceholder, aiplacement_assistant {{/str}}"></textarea>
            <button type="submit" class="btn btn-primary align-self-end" data-action="aiplacement_assistant-send">
                {{#str}} send, aiplacement_assistant {{/str}}
            </button>
        </form>
    </section>
</div>
